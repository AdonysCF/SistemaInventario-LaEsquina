<c:url var="urlInicio" value="/panelGerente.jsp"/>
<c:url var="urlVenta" value="/VentaServlet"/>
<c:url var="urlHistorial" value="/HistorialVentaServlet"/>
<c:url var="urlConsulta" value="/ConsultaServlet"/>
<c:url var="urlEntrada" value="/EntradaServlet"/>
<c:url var="urlAjuste" value="/AjusteServlet"/>
<c:url var="urlKardex" value="/KardexServlet"/>

<c:url var="urlProductos" value="/ProductoServlet">
    <c:param name="accion" value="listar"/>
</c:url>
<c:url var="urlCategorias" value="/CategoriaServlet">
    <c:param name="accion" value="listar"/>
</c:url>

<c:url var="urlReporteVentas" value="/ReporteVentasServlet"/>
<c:url var="urlReposiciones" value="/ReporteReposicionServlet"/>

<c:url var="urlUsuarios" value="/UsuarioServlet">
    <c:param name="accion" value="listar"/>
</c:url>
<c:url var="urlSalir" value="/login">
    <c:param name="accion" value="salir"/>
</c:url>

<a class="visually-hidden-focusable position-absolute top-0 start-0 z-3 bg-white p-2"
   href="#contenidoGerencia">Ir al contenido principal</a>

<div class="cashier-layout">
    <aside class="cashier-sidebar offcanvas-lg offcanvas-start" tabindex="-1"
           id="menuGerencia" aria-labelledby="marcaGerencia">
        <div class="sidebar-surface">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <a id="marcaGerencia" class="brand" href="${urlInicio}">
                    <i class="bi bi-shop" aria-hidden="true"></i>
                    <span>La Esquina</span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none p-2"
                        data-bs-dismiss="offcanvas" data-bs-target="#menuGerencia"
                        aria-label="Cerrar menú"></button>
            </div>

            <nav class="cashier-nav gerencia-nav" aria-label="Navegación de gerencia">
                <a class="menu-link" href="<c:out value='${urlInicio}'/>"
                   aria-current="${pantallaGerencia eq 'Inicio' ? 'page' : 'false'}">
                    <i class="bi bi-house-door" aria-hidden="true"></i> Inicio
                </a>

                <div class="nav-group" role="group" aria-labelledby="grupoGerencia1">
                    <p class="nav-heading" id="grupoGerencia1">Ventas</p>
                    <a class="menu-link" href="<c:out value='${urlVenta}'/>"
                       aria-current="${pantallaGerencia eq 'Venta' ? 'page' : 'false'}">
                        <i class="bi bi-cart" aria-hidden="true"></i> Registrar venta
                    </a>
                    <a class="menu-link" href="<c:out value='${urlHistorial}'/>"
                       aria-current="${pantallaGerencia eq 'Historial' ? 'page' : 'false'}">
                        <i class="bi bi-receipt" aria-hidden="true"></i> Historial de ventas
                    </a>
                </div>

                <div class="nav-group" role="group" aria-labelledby="grupoGerencia2">
                    <p class="nav-heading" id="grupoGerencia2">Inventario</p>
                    <a class="menu-link" href="<c:out value='${urlConsulta}'/>"
                       aria-current="${pantallaGerencia eq 'Consulta' ? 'page' : 'false'}">
                        <i class="bi bi-search" aria-hidden="true"></i> Consultar existencias
                    </a>
                    <a class="menu-link" href="<c:out value='${urlEntrada}'/>"
                       aria-current="${pantallaGerencia eq 'Entrada' ? 'page' : 'false'}">
                        <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> Registrar entrada
                    </a>
                    <a class="menu-link" href="<c:out value='${urlAjuste}'/>"
                       aria-current="${pantallaGerencia eq 'Ajuste' ? 'page' : 'false'}">
                        <i class="bi bi-sliders" aria-hidden="true"></i> Ajustar stock
                    </a>
                    <a class="menu-link" href="<c:out value='${urlKardex}'/>"
                       aria-current="${pantallaGerencia eq 'Kardex' ? 'page' : 'false'}">
                        <i class="bi bi-clock-history" aria-hidden="true"></i> Movimientos (Kardex)
                    </a>
                </div>

                <div class="nav-group" role="group" aria-labelledby="grupoGerencia3">
                    <p class="nav-heading" id="grupoGerencia3">Catálogo</p>
                    <a class="menu-link" href="<c:out value='${urlProductos}'/>"
                       aria-current="${pantallaGerencia eq 'Productos' ? 'page' : 'false'}">
                        <i class="bi bi-box-seam" aria-hidden="true"></i> Productos
                    </a>
                    <a class="menu-link" href="<c:out value='${urlCategorias}'/>"
                       aria-current="${pantallaGerencia eq 'Categorias' ? 'page' : 'false'}">
                        <i class="bi bi-tags" aria-hidden="true"></i> Categorías
                    </a>
                </div>

                <div class="nav-group" role="group" aria-labelledby="grupoGerencia4">
                    <p class="nav-heading" id="grupoGerencia4">Reportes</p>
                    <a class="menu-link" href="<c:out value='${urlReporteVentas}'/>"
                       aria-current="${pantallaGerencia eq 'ReporteVentas' ? 'page' : 'false'}">
                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Ventas por período
                    </a>
                    <a class="menu-link" href="<c:out value='${urlReposiciones}'/>"
                       aria-current="${pantallaGerencia eq 'Reposiciones' ? 'page' : 'false'}">
                        <i class="bi bi-clipboard-data" aria-hidden="true"></i> Planificar reposiciones
                    </a>
                </div>

                <div class="nav-group" role="group" aria-labelledby="grupoGerencia5">
                    <p class="nav-heading" id="grupoGerencia5">Administración</p>
                    <a class="menu-link" href="<c:out value='${urlUsuarios}'/>"
                       aria-current="${pantallaGerencia eq 'Usuarios' ? 'page' : 'false'}">
                        <i class="bi bi-people" aria-hidden="true"></i> Usuarios
                    </a>
                </div>
            </nav>
        </div>
    </aside>

    <div class="cashier-workspace">
        <header class="topbar">
            <div class="title-group">
                <button type="button" class="btn btn-outline-secondary d-lg-none"
                        data-bs-toggle="offcanvas" data-bs-target="#menuGerencia"
                        aria-controls="menuGerencia">
                    <i class="bi bi-list" aria-hidden="true"></i> Menú
                </button>
                <h1><c:out value="${tituloGerencia}"/></h1>
            </div>

            <div class="session-actions">
                <div class="user-info">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <div>
                        <strong><c:out value="${sessionScope.usuarioSesion.nombreCompleto}"/></strong>
                        <small>Gerente</small>
                    </div>
                </div>
                <a class="btn btn-outline-dark" href="<c:out value='${urlSalir}'/>">
                    <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i> Cerrar sesión
                </a>
            </div>
        </header>